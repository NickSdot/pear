# Generated by bin/generate pear generate
RewriteEngine On

# Bug pages
RewriteCond %{QUERY_STRING} (^|&)id=([0-9]+)(&|$) [NC]
RewriteRule ^bugs/bug\.php$ bugs/%2/ [R=301,L,QSD]
RewriteRule ^bugs/([0-9]+)(?:\.html)?$ bugs/$1/ [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)package=([^&]+)(&|$) [NC]
RewriteRule ^bugs/report\.php$ package/%2/ [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)package_name(?:\[\]|%5B%5D)=([^&]+)(&|$) [NC]
RewriteRule ^bugs/search\.php$ package/%2/ [R=301,L,QSD]
RewriteRule ^bugs/(?:report|roadmap|stats|search|bug-pwd-finder|resend-request-email)\.php$ ./ [R=301,L,QSD]

# Package listing
RewriteRule ^(?:packages\.php|index\.php)$ ./ [R=301,L,QSD]

